<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gof2Workshop.Core\Gof2Workshop.Core.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Export\Gof2Workshop.Export.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Formats.Aei\Gof2Workshop.Formats.Aei.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Formats.Aem\Gof2Workshop.Formats.Aem.csproj" />
    <ProjectReference Include="..\Gof2Workshop.GameData\Gof2Workshop.GameData.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Import\Gof2Workshop.Import.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Scene\Gof2Workshop.Scene.csproj" />
    <ProjectReference Include="..\Gof2Workshop.Workbench\Gof2Workshop.Workbench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\Assets\Models\synthetic_animated.aem"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic_animated.aem" />
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\Assets\Textures\synthetic_spacecraft_diffuse.aei"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic_animated.aei" />
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\Assets\Textures\synthetic_raw.aei"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic_raw.aei" />
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\synthetic-atlas-preview.png"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic-atlas-preview.png" />
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\Assets\Imported\synthetic_cube_import.gltf"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic_cube_import.gltf" />
    <EmbeddedResource Include="..\..\samples\SyntheticDemo\Assets\Imported\synthetic_cube_import.bin"
                      LogicalName="Gof2Workshop.Browser.Samples.synthetic_cube_import.bin" />
  </ItemGroup>

</Project>
