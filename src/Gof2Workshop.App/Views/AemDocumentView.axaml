<UserControl
    x:Class="Gof2Workshop.App.Views.AemDocumentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Gof2Workshop.App.Views"
    AutomationProperties.AutomationId="ActiveAemDocument"
    AutomationProperties.Name="{Binding Asset.FileName}">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="7,5" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <views:CompactHorizontalScroller ScrollStep="160">
        <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Command="{Binding FrameAllCommand}" Content="Frame All" />
        <Button Command="{Binding FrameSelectedCommand}" Content="Frame Selected" />
        <Button Command="{Binding ResetCameraCommand}" Content="Reset Camera" />
        <ToggleButton IsChecked="{Binding Perspective}" Content="Perspective" />
        <ComboBox Width="150" ItemsSource="{Binding ViewportModes}"
                  SelectedItem="{Binding ViewportMode}" />
        <ToggleButton IsChecked="{Binding Wireframe}" Content="Wire" />
        <ToggleButton IsChecked="{Binding ShowNormals}" Content="Normals" />
        <ToggleButton IsChecked="{Binding ShowPivots}" Content="Pivots" />
        <ToggleButton IsChecked="{Binding ShowBounds}" Content="Bounds" />
        <ToggleButton IsChecked="{Binding ShowFaceWinding}" Content="Winding" />
        <ToggleButton IsChecked="{Binding BackFaceCulling}" Content="Cull" />
        <ToggleButton IsChecked="{Binding UseSoftwareRenderer}"
                      ToolTip.Tip="Use the deterministic CPU renderer instead of OpenGL"
                      Content="Software" />
        <Button Command="{Binding ExportGltfCommand}" Content="Export glTF" />
        <Button Command="{Binding ExportObjCommand}" Content="Export OBJ" />
        <Button Command="{Binding SaveAemCopyCommand}"
                ToolTip.Tip="Write a validated reconstructed AEM copy outside the game folder"
                Content="Save AEM Copy" />
        <StackPanel Margin="10,0" Orientation="Horizontal" Spacing="5">
          <TextBlock VerticalAlignment="Center" Opacity="0.7"
                     MaxWidth="260" Text="{Binding RenderStatus}" TextTrimming="CharacterEllipsis" />
          <TextBlock VerticalAlignment="Center" Opacity="0.5" Text="{Binding ViewportSizeLabel}" />
          <TextBlock VerticalAlignment="Center" Opacity="0.5" Text="{Binding CameraStatus}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Foreground="#64B5F6"
                   FontSize="10" FontWeight="SemiBold" Text="{Binding OwnershipLabel}" />
        </StackPanel>
      </views:CompactHorizontalScroller>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,5,280">
      <Grid Background="#0E1218">
        <views:OpenGlAemViewportControl Document="{Binding}"
                                        IsVisible="{Binding UseOpenGlRenderer}" />
        <views:AemViewportControl Document="{Binding}"
                                  IsVisible="{Binding UseSoftwareRenderer}" />
        <Border x:Name="ViewportInputSurface"
                Background="Transparent"
                Focusable="True"
                AutomationProperties.AutomationId="AemViewportInput"
                AutomationProperties.Name="AEM viewport interaction surface"
                ToolTip.Tip="Left drag to orbit · Right or middle drag to pan · Wheel to zoom" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,5"
                Background="#D0141A22" CornerRadius="3">
          <StackPanel>
            <TextBlock Text="{Binding AnimationSummary}" FontSize="11" />
            <Grid IsVisible="{Binding HasAnimation}" Margin="0,4,0,2"
                  ColumnDefinitions="Auto,Auto,150,Auto" ColumnSpacing="5">
              <Button Command="{Binding PlayPauseCommand}" Content="{Binding PlaybackLabel}" />
              <Button Grid.Column="1" Command="{Binding StopAnimationCommand}" Content="Stop" />
              <Slider Grid.Column="2" Minimum="0" Maximum="{Binding AnimationDurationSeconds}"
                      Value="{Binding AnimationTimeSeconds}" />
              <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding AnimationTimeLabel}" />
            </Grid>
            <TextBlock Opacity="0.65" FontSize="10"
                       Text="Left drag orbit · Right drag pan · Wheel zoom" />
          </StackPanel>
        </Border>
        <ProgressBar IsVisible="{Binding IsRendering}" IsIndeterminate="True"
                     VerticalAlignment="Bottom" Height="3" />
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#343B46" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock Classes="section" Text="SCENE / SUBMESHES" />
        <CheckBox Grid.Row="1" Margin="8,0,8,6" IsChecked="{Binding IsolateSubmesh}"
                  Content="Isolate selected submesh" />
        <Border Grid.Row="2" Margin="8,0,8,7" Padding="7" Background="#18212B" CornerRadius="3">
          <TextBlock Text="{Binding Winding.Interpretation}" TextWrapping="Wrap" FontSize="11" />
        </Border>
        <Border Grid.Row="3" Margin="8,0,8,7" Padding="7"
                BorderBrush="#3A4655" BorderThickness="1" CornerRadius="3">
          <StackPanel Spacing="4">
            <TextBlock FontSize="10" FontWeight="SemiBold" Text="MATERIAL / AEI" />
            <TextBlock Text="{Binding SelectedMaterialAssignment.TextureName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock FontSize="10" Opacity="0.68"
                       Text="{Binding SelectedMaterialAssignment.Confidence}" />
            <TextBlock FontSize="10" Opacity="0.68" TextWrapping="Wrap"
                       MaxHeight="45" Text="{Binding SelectedMaterialAssignment.Reason}" />
            <WrapPanel>
              <Button Margin="0,2,4,0" Command="{Binding AssignMaterialCommand}"
                      Content="Assign…" />
              <Button Margin="0,2,4,0" Command="{Binding ClearMaterialCommand}"
                      Content="Clear" />
              <Button Margin="0,2,0,0" Command="{Binding ResetMaterialCommand}"
                      Content="Automatic" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <ListBox Grid.Row="4" Margin="4" ItemsSource="{Binding Submeshes}"
                 SelectedItem="{Binding SelectedSubmesh}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,3" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Grid.Row="1" Opacity="0.58" FontSize="10"
                           Text="{Binding Triangles}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
