<Application
    x:Class="Gof2Workshop.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:documents="using:Gof2Workshop.App.Documents"
    xmlns:views="using:Gof2Workshop.App.Views">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="8,7,8,4" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="views|CompactHorizontalScroller">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="*,20,20">
            <ScrollViewer Name="PART_ScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ScrollViewer>
            <Button Name="PART_PreviousButton"
                    Grid.Column="1"
                    Classes="compactScroll"
                    ToolTip.Tip="Scroll left"
                    Content="‹" />
            <Button Name="PART_NextButton"
                    Grid.Column="2"
                    Classes="compactScroll"
                    ToolTip.Tip="Scroll right"
                    Content="›" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.compactScroll">
      <Setter Property="Width" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="1,3" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style Selector="Button.compactScroll:pointerover">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="documents:WelcomeDocumentViewModel">
      <views:WelcomeDocumentView />
    </DataTemplate>
    <DataTemplate DataType="documents:AeiDocumentViewModel">
      <views:AeiDocumentView />
    </DataTemplate>
    <DataTemplate DataType="documents:AemDocumentViewModel">
      <views:AemDocumentView />
    </DataTemplate>
    <DataTemplate DataType="documents:UnsupportedDocumentViewModel">
      <views:UnsupportedDocumentView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
