# Galaxy on Fire 2 Workshop OBJ export
# Source convention: AEM source XYZ, float32, source winding retained.
# Normalized convention: Right-handed XYZ retained provisionally; glTF Y-up declaration; UV V converted to 1-V.
mtllib synthetic_cube_import.mtl

o submesh_00
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vt 0.4 0.6
vt 0.6 0.6
vt 0.6 0.6
vt 0.4 0.6
vt 0.4 0.39999998
vt 0.6 0.39999998
vt 0.6 0.39999998
vt 0.4 0.39999998
vn -0.57735026 -0.57735026 -0.57735026
vn 0.57735026 -0.57735026 -0.57735026
vn 0.57735026 0.57735026 -0.57735026
vn -0.57735026 0.57735026 -0.57735026
vn -0.57735026 -0.57735026 0.57735026
vn 0.57735026 -0.57735026 0.57735026
vn 0.57735026 0.57735026 0.57735026
vn -0.57735026 0.57735026 0.57735026
g submesh_00
usemtl material_00
f 1/1/1 3/3/3 2/2/2
f 1/1/1 4/4/4 3/3/3
f 5/5/5 6/6/6 7/7/7
f 5/5/5 7/7/7 8/8/8
f 1/1/1 2/2/2 6/6/6
f 1/1/1 6/6/6 5/5/5
f 3/3/3 4/4/4 8/8/8
f 3/3/3 8/8/8 7/7/7
f 1/1/1 5/5/5 8/8/8
f 1/1/1 8/8/8 4/4/4
f 2/2/2 3/3/3 7/7/7
f 2/2/2 7/7/7 6/6/6
